# JanSetu Frontend Configuration Example
# Copy to .env for local development. Never commit sensitive values.

# Google OAuth Client ID (Web application client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Custom API URL for local backend development (defaults to Render backend)
# VITE_API_URL=http://localhost:5000

