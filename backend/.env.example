# Copy this file to .env and fill in real values.
# Never commit .env to Git.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# Port (Render sets this automatically; use 5000 for local dev)
PORT=5000

# Node environment
NODE_ENV=development

# JWT secret for user sessions (min 32 random characters)
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# JWT secret for admin sessions (min 32 random characters)
ADMIN_JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# Admin panel password (strong passphrase)
ADMIN_PASSWORD=<strong-passphrase>

# Secret header value for the /api/jobs/expired cron endpoint
CRON_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
